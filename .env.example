# Mall för miljövariabler. Kopiera till .env och fyll i värden.
# Filen .env läggs i .gitignore och committas ALDRIG.

# --- AI-leverantörer (modellagnostiskt lager, B-009 / B-025) ---
# Se 02_system/ai_abstraktion.md §7. En nyckel räcker för att komma igång –
# varje modellroll har reservmodell hos den andra leverantören.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Valfria team-nycklar (eget Anthropic Workspace / OpenAI Project per team,
# med eget kostnadstak). Format: <NYCKELVARIABEL>_<TEAM-ID>, team-id enligt
# 02_system/agentekosystem.md §3.3. Saknas de används nycklarna ovan.
# ANTHROPIC_API_KEY_KAPITAL=
# OPENAI_API_KEY_KAPITAL=

# Valfria överstyrningar av AI-lagret
# AI_ROLE_DEEP=openai:gpt-6-astra   # byt primärmodell för en roll (fast/standard/deep)
# AI_CONFIG_FILE=                   # alternativ ai_config.yaml
# AI_TRACE_FILE=                    # annan sökväg för anropsloggen (standard logs/ai_calls.jsonl)
# AI_LOG_CONTENT=false              # true loggar promptar och svar – bara felsökning (B-006)

# --- Databricks Lakebase (B-018, ersätter Supabase/B-014) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Databasanslutning för SQLAlchemy ---
# Lakebase är Postgres-kompatibel. Format:
# postgresql://<role>:<password>@<lakebase-host>.databricks.com/databricks_postgres?sslmode=require
DATABASE_URL=

# Agentteamens begränsade databasroller (harness.md §5.1). Samma värd och databas som
# DATABASE_URL men egen roll utan superuser; rättigheter: scripts/setup/grant_agent_role.py
AGENT_FORSAKRING_DATABASE_URL=
AGENT_AKTUARIE_DATABASE_URL=
AGENT_COMPLIANCE_DATABASE_URL=

# Isolerad testdatabas för Postgres-testerna (markören postgres i tests/suites.toml:
# tests/test_services_postgres.py, tests/test_agents_postgres_*.py och migreringsproven)
# – aldrig beståndet. Databasen svc_test i samma projekt. Adresserna räcker inte för att
# köra proven: de körs bara med `run_tests.py --postgres` eller RUN_POSTGRES_TESTS=1 satt
# i skalet. Lägg inte RUN_POSTGRES_TESTS här (02_system/teststrategi.md).
SERVICES_TEST_POSTGRES_URL=
SERVICES_TEST_AGENT_POSTGRES_URL=
# Valfria: teamrollerna mot svc_test (samma roll och lösenord, databasen svc_test).
# Saknas de provas teamets rättigheter på rollen ovan.
# SERVICES_TEST_AKTUARIE_POSTGRES_URL=
# SERVICES_TEST_COMPLIANCE_POSTGRES_URL=

# Operatörscentral OC-1/2: valfria, inga källor ansluts automatiskt.
# OPERATOR_TELEMETRY_MANIFEST=        # absolut sökväg till lokalt, granskat JSON-manifest
# OPERATOR_DATASET_ID=               # stabil datasetreferens; ny referens efter återställning/scenariobyte
